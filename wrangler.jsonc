{
	"name": "kioku-public",
	"compatibility_date": "2026-10-23",
	// The Worker only gates /demo behind a password; every other path is served straight from assets.
	"main": "worker/index.js",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": ["/demo", "/demo/*"]
	},
	"previews": {},
	"routes": [{ "pattern": "ingle.askp.one", "custom_domain": true }]
}
